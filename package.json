{
  "name": "eslint-plugin-ai-guard",
  "version": "1.3.0",
  "description": "GitHub-native guardrails for AI-generated code. ESLint plugin and GitHub Action for detecting async reliability issues, floating promises, empty catch blocks, hardcoded secrets, SQL injection, and more. SARIF-based GitHub Code Scanning integration with PR annotations and persistent security alerts.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "ai",
    "ai-generated-code",
    "github-actions",
    "sarif",
    "code-scanning",
    "github-security",
    "async",
    "async-reliability",
    "reliability",
    "guardrails",
    "security",
    "pull-request",
    "ci",
    "workflow",
    "copilot",
    "cursor",
    "claude",
    "developer-tools",
    "llm",
    "linting",
    "static-analysis"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "ai-guard": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "npm run build && eslint src cli tests --ext .ts",
    "lint:self": "node dist/cli/index.js run --path src",
    "lint:full": "node dist/cli/index.js run --path src --strict && node dist/cli/index.js run --path cli --strict",
    "init-context": "node dist/cli/index.js init-context",
    "prepublishOnly": "npm run typecheck && npm run test && npm run lint && npm run build"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": ">=6.0.0",
    "eslint": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/rule-tester": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitepress": "^1.3.4",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "@typescript-eslint/utils": "^8.0.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^8.2.0",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-guard-dev/eslint-plugin-ai-guard.git"
  },
  "bugs": {
    "url": "https://github.com/ai-guard-dev/eslint-plugin-ai-guard/issues"
  },
  "homepage": "https://github.com/ai-guard-dev/eslint-plugin-ai-guard#readme",
  "author": "YashJadhav21",
  "license": "MIT"
}
